<Page x:Class="DeclarationApp.Demo.Views.InvoiceEditorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Edit Declaration">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Page header -->
        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Text="Edit Declaration"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- Declaration Number -->
        <Label Grid.Row="1" Grid.Column="0"
               Content="Declaration Number:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="DeclarationNumberBox"
                 AutomationProperties.AutomationId="InvoiceEditor.DeclarationNumberBox"
                 Text="{Binding DeclarationNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4"/>

        <!-- Exporter IIN -->
        <Label Grid.Row="2" Grid.Column="0"
               Content="Exporter IIN:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="2" Grid.Column="1"
                 x:Name="ExporterIinBox"
                 AutomationProperties.AutomationId="InvoiceEditor.ExporterIinBox"
                 Text="{Binding ExporterIin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4"/>

        <!-- Action buttons -->
        <StackPanel Grid.Row="3"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,12,0,0">
            <Button x:Name="SaveButton"
                    Content="Save"
                    AutomationProperties.AutomationId="InvoiceEditor.SaveButton"
                    Command="{Binding SaveCommand}"
                    Width="100"/>
            <Button x:Name="GoodsButton"
                    Content="Edit Goods Items →"
                    AutomationProperties.AutomationId="InvoiceEditor.GoodsButton"
                    Command="{Binding NavigateToGoodsCommand}"
                    Width="160"/>
        </StackPanel>

        <!-- Hint -->
        <TextBlock Grid.Row="4"
                   Grid.ColumnSpan="2"
                   Text="Note: Exporter IIN is stored as a hashed value in the trace log."
                   Foreground="Gray"
                   FontSize="11"
                   Margin="4,16,0,0"/>
    </Grid>
</Page>
