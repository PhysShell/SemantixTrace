<Page x:Class="DeclarationApp.Demo.Views.ExportDialogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Export Declaration">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Page header -->
        <TextBlock Grid.Row="0"
                   Grid.ColumnSpan="2"
                   Text="Export Declaration"
                   FontSize="20"
                   FontWeight="Bold"
                   Margin="0,0,0,16"/>

        <!-- Exporter IIN field -->
        <Label Grid.Row="1" Grid.Column="0"
               Content="Exporter IIN:"
               VerticalAlignment="Center"/>
        <TextBox Grid.Row="1" Grid.Column="1"
                 x:Name="ExporterIinBox"
                 AutomationProperties.AutomationId="ExportDialog.ExporterIinBox"
                 Text="{Binding ExporterIin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                 Margin="4"/>

        <!-- Validate IIN button -->
        <Button Grid.Row="2" Grid.Column="1"
                x:Name="ValidateIinButton"
                Content="Validate IIN"
                AutomationProperties.AutomationId="ExportDialog.ValidateIinButton"
                Command="{Binding ValidateIinCommand}"
                HorizontalAlignment="Left"
                Width="120"
                Margin="4"/>

        <!-- Validation message -->
        <TextBlock Grid.Row="3"
                   Grid.ColumnSpan="2"
                   x:Name="ValidationMessageText"
                   AutomationProperties.AutomationId="ExportDialog.ValidationMessage"
                   Text="{Binding ValidationMessage}"
                   TextWrapping="Wrap"
                   Foreground="#CC0000"
                   Margin="4,4,0,8"/>

        <!-- Export status -->
        <TextBlock Grid.Row="4"
                   Grid.ColumnSpan="2"
                   Text="{Binding ExportStatus}"
                   Foreground="#006600"
                   FontStyle="Italic"
                   Margin="4,0,0,8"/>

        <!-- Export button -->
        <StackPanel Grid.Row="5"
                    Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Margin="0,8,0,0">
            <!--
                BUG 2: IsEnabled is bound to CanSubmit. Because ValidateIinCommand
                does NOT call CommandManager.InvalidateRequerySuggested() or set
                CanSubmit = false after opening the DuplicateIinErrorModal, this
                button stays enabled even when the IIN is a duplicate.
            -->
            <Button x:Name="SubmitExportButton"
                    Content="Export Declaration"
                    AutomationProperties.AutomationId="ExportDialog.SubmitExportButton"
                    Command="{Binding SubmitCommand}"
                    IsEnabled="{Binding CanSubmit}"
                    Width="160"/>
        </StackPanel>

        <!-- BUG 2 hint -->
        <TextBlock Grid.Row="6"
                   Grid.ColumnSpan="2"
                   TextWrapping="Wrap"
                   Text="Note: Clicking 'Validate IIN' on a duplicate IIN shows an error modal but the Export button remains enabled (BUG 2 — CanSubmit not invalidated after duplicate IIN error)."
                   Foreground="Gray"
                   FontSize="11"
                   Margin="4,16,0,0"/>
    </Grid>
</Page>
