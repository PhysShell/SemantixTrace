<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:trace="clr-namespace:SemantxTrace.Avalonia;assembly=Trace.Avalonia"
             xmlns:vm="clr-namespace:DeclarationApp.Demo.Avalonia.ViewModels"
             x:Class="DeclarationApp.Demo.Avalonia.Views.InvoiceListPage"
             trace:AutoAutomationId.IsEnabled="True">

  <StackPanel Margin="16" Spacing="12">
    <TextBlock FontSize="20" FontWeight="Bold" Text="Declarations" />

    <ListBox Name="DeclarationsList"
             ItemsSource="{Binding Declarations}"
             SelectedItem="{Binding SelectedDeclaration}"
             Height="200">
      <ListBox.ItemTemplate>
        <DataTemplate>
          <TextBlock Text="{Binding Number}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Name="NewDeclarationButton"
              Content="New Declaration"
              Command="{Binding NewDeclarationCommand}" />
      <Button Name="OpenDeclarationButton"
              Content="Open Selected"
              Command="{Binding OpenDeclarationCommand}" />
    </StackPanel>
  </StackPanel>

</UserControl>
