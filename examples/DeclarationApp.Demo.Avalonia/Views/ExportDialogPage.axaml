<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:trace="clr-namespace:SemantxTrace.Avalonia;assembly=Trace.Avalonia"
             x:Class="DeclarationApp.Demo.Avalonia.Views.ExportDialogPage"
             trace:AutoAutomationId.IsEnabled="True">

  <Grid RowDefinitions="*,Auto">

    <!-- Main export form -->
    <StackPanel Grid.Row="0" Margin="16" Spacing="10">
      <TextBlock FontSize="20" FontWeight="Bold" Text="Export Dialog" />

      <StackPanel Spacing="4">
        <TextBlock Text="Exporter IIN" />
        <TextBox Name="ExporterIinBox" Text="{Binding ExporterIin}" />
      </StackPanel>

      <TextBlock Name="ValidationMessageText" Text="{Binding ValidationMessage}" />
      <TextBlock Name="ExportStatusText"      Text="{Binding ExportStatus}" />

      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button Name="ValidateIinButton" Content="Validate IIN" Command="{Binding ValidateIinCommand}" />
        <Button Name="SubmitExportButton" Content="Submit Export"
                Command="{Binding SubmitCommand}"
                IsEnabled="{Binding CanSubmit}" />
      </StackPanel>
    </StackPanel>

    <!-- DuplicateIinErrorModal overlay -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            Background="#CC000000"
            IsVisible="{Binding IsDuplicateModalVisible}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                  Background="White" Padding="24" Spacing="12" Width="360">
        <TextBlock FontSize="16" FontWeight="Bold" Text="Duplicate IIN Error" />
        <TextBlock Text="This IIN is already registered. Export has been blocked." TextWrapping="Wrap" />
        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
          <Button Name="DismissModalButton" Content="Dismiss"
                  Command="{Binding DismissModalCommand}" />
          <Button Name="SubmitAnywayButton" Content="Submit Anyway"
                  Command="{Binding SubmitCommand}" />
        </StackPanel>
      </StackPanel>
    </Border>

  </Grid>

</UserControl>
