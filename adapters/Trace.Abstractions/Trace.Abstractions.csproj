<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Trace.Abstractions</PackageId>
    <Description>
      Contract-only NuGet for SemantxTrace: ITraceContext, ValuePolicy,
